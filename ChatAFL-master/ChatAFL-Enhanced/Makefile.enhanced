# Makefile for ChatAFL-Enhanced integrated build

CC = gcc
CFLAGS = -Wall -O2 -g -fPIC -I.
LDFLAGS = -lm

# Libraries
LIBS = -lcurl -ljson-c -lpcre2-8

# ChatAFL-Enhanced module sources
ENHANCED_SOURCES = verifier.c cegar-refinement.c state-scheduler.c
ENHANCED_OBJECTS = $(ENHANCED_SOURCES:.c=.o)

# Standalone test target
STANDALONE_TARGET = test_verified_loop
STANDALONE_SOURCES = verified-loop.c

# Integrated AFL targets (requires full AFL compilation)
AFL_FUZZ_PATCHED = ../afl-fuzz-enhanced
AFL_CLIENT_PATCHED = ../aflnet-client-enhanced
CHAT_LLM_PATCHED = ../chat-llm-enhanced.o

.PHONY: all standalone integrated clean test install help

# Default: build standalone verified loop
all: standalone

# Standalone verified loop executable (works independently)
standalone: $(STANDALONE_TARGET)

$(STANDALONE_TARGET): $(ENHANCED_OBJECTS) verified-loop.o
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS) $(LDFLAGS)
	@echo "[OK] Standalone verified loop built: ./$(STANDALONE_TARGET)"

# Integrated build (requires full AFL codebase)
integrated: $(ENHANCED_OBJECTS)
	@echo "Building enhanced modules as static library..."
	ar rcs libchatafl-enhanced.a $(ENHANCED_OBJECTS)
	@echo "[OK] Static library built: libchatafl-enhanced.a"
	@echo ""
	@echo "Integration notes:"
	@echo "  - afl-fuzz.c, aflnet-client.c, chat-llm.c have been patched"
	@echo "  - To build full AFL with enhancements:"
	@echo "    1. cd .. && make clean"
	@echo "    2. make CHATAFL_ENHANCED=1"
	@echo "    3. Link with -L./ChatAFL-Enhanced -lchatafl-enhanced"

# Object file compilation
%.o: %.c %.h
	$(CC) $(CFLAGS) -c $< -o $@

verified-loop.o: verified-loop.c verifier.h cegar-refinement.h state-scheduler.h
	$(CC) $(CFLAGS) -c verified-loop.c -o $@

# Cleaning
clean:
	rm -f $(ENHANCED_OBJECTS) verified-loop.o $(STANDALONE_TARGET) libchatafl-enhanced.a
	rm -rf .vloop_logs .sched_log .cegar_cache .verifier_log

# Run basic tests
test: standalone
	@echo "Running ChatAFL-Enhanced verified loop test..."
	./$(STANDALONE_TARGET)
	@echo ""
	@echo "[OK] Verified loop test passed"

# Install headers and library to system
install: integrated
	install -d /usr/local/include/chatafl-enhanced
	install -m 644 verifier.h cegar-refinement.h state-scheduler.h /usr/local/include/chatafl-enhanced/
	install -m 644 libchatafl-enhanced.a /usr/local/lib/
	@echo "[OK] Headers installed to /usr/local/include/chatafl-enhanced/"
	@echo "[OK] Library installed to /usr/local/lib/libchatafl-enhanced.a"

help:
	@echo "ChatAFL-Enhanced Build System"
	@echo "============================="
	@echo ""
	@echo "Targets:"
	@echo "  standalone - Build test_verified_loop (default)"
	@echo "  integrated - Build libchatafl-enhanced.a for AFL integration"
	@echo "  test       - Run standalone verification tests"
	@echo "  clean      - Remove all build artifacts"
	@echo "  install    - Install headers and library to system"
	@echo "  help       - Show this message"
	@echo ""
	@echo "Integration Status:"
	@echo "  ✓ afl-fuzz.c: State scheduler + plateau detection"
	@echo "  ✓ aflnet-client.c: Response verifier"
	@echo "  ✓ chat-llm.c: CEGAR grammar validation"
	@echo ""
	@echo "Dependencies:"
	@echo "  - libcurl-dev (HTTP client for LLM)"
	@echo "  - libjson-c-dev (JSON parsing)"
	@echo "  - libpcre2-dev (Regex for parseability)"
	@echo ""
	@echo "Quick Start:"
	@echo "  make standalone    # Build test executable"
	@echo "  make test          # Run verification tests"
	@echo "  make integrated    # Build AFL-ready library"
