    "Password: <<VALUE>>\r\n"
]

CONNECT_DUPLICATE: [
    "CONNECT <<VALUE>>\r\n",
    "ClientId: <<VALUE>>\r\n",
    "CleanSession: <<VALUE>>\r\n",
    "KeepAlive: <<VALUE>>\r\n",
    "WillTopic: <<VALUE>>\r\n",
    "WillMessage: <<VALUE>>\r\n",
    "WillQoS: <<VALUE>>\r\n",
    "WillRetain: <<VALUE>>\r\n",
    "Username: <<VALUE>>\r\n",
    "Password: <<VALUE>>\r\n",
    "Duplicate: true\r\n"
]

SUBSCRIBE: [
    "SUBSCRIBE <<VALUE>>\r\n",
    "TopicFilter: <<VALUE>>\r\n",
    "QoS: <<VALUE>>\r\n"
]

SUBSCRIBE_WILDCARD: [
    "SUBSCRIBE <<VALUE>>\r\n",
    "TopicFilter: <<VALUE>>/#\r\n",  // Wildcard for all subtopics
    "QoS: <<VALUE>>\r\n"
]

PUBLISH: [
    "PUBLISH <<VALUE>>\r\n",
    "Topic: <<VALUE>>\r\n",
    "Payload: <<VALUE>>\r\n",
    "QoS: <<VALUE>>\r\n",
    "Retain: <<VALUE>>\r\n",
    "MessageId: <<VALUE>>\r\n"  // For QoS 1 and 2
]

PUBLISH_DUPLICATE: [
    "PUBLISH <<VALUE>>\r\n",
    "Topic: <<VALUE>>\r\n",
    "Payload: <<VALUE>>\r\n",
    "QoS: <<VALUE>>\r\n",
    "Retain: <<VALUE>>\r\n",
    "MessageId: <<VALUE>>\r\n",
    "Duplicate: true\r\n"
]

UNSUBSCRIBE: [
    "UNSUBSCRIBE <<VALUE>>\r\n",
