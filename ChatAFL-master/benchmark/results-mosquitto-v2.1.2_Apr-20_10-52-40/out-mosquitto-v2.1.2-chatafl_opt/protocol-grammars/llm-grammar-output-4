]

PUBREC: [
    "PUBREC <<PACKET_ID>>\r\n"
]

PUBREL: [
    "PUBREL <<PACKET_ID>>\r\n"
]

PUBCOMP: [
    "PUBCOMP <<PACKET_ID>>\r\n"
]

