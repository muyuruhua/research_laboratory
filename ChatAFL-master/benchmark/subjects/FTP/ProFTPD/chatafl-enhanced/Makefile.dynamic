# Makefile.dynamic - Build AFL with dynamic plugin support
#
# This Makefile produces:
# 1. afl-fuzz (clean version with plugin loader, NO Enhanced code)
# 2. chatafl-enhanced.so (all Enhanced functionality as .so)
#
# Usage:
#   make -f Makefile.dynamic all
#   ./afl-fuzz --load-plugin ./chatafl-enhanced.so -i in -o out -- ./target

CC ?= gcc
CFLAGS ?= -O3 -funroll-loops
CFLAGS += -Wall -D_FORTIFY_SOURCE=2 -g -Wno-pointer-sign \
          -DAFL_PATH=\"/usr/local/lib/afl\" -DDOC_PATH=\"/usr/local/share/doc/afl\" \
          -DBIN_PATH=\"/usr/local/bin\"

# macOS compatibility
ifneq "$(shell uname)" "Linux"
  CFLAGS += -Wno-deprecated-declarations
  LDFLAGS += -lresolv
endif

# Detect macOS graphviz installation
GRAPHVIZ_BREW := $(shell brew --prefix graphviz 2>/dev/null)
ifneq ($(GRAPHVIZ_BREW),)
  CFLAGS += -I$(GRAPHVIZ_BREW)/include
  LDFLAGS += -L$(GRAPHVIZ_BREW)/lib
endif

# Plugin system flags
PLUGIN_CFLAGS = -fPIC -fvisibility=hidden
PLUGIN_LDFLAGS = -shared -ldl

# Libraries for Enhanced plugin
ENHANCED_LIBS = -lgvc -lcgraph -ljson-c -lpcre2-8

# AFL core source files (NO Enhanced code)
AFL_CORE_OBJS = afl-fuzz.o afl-plugin-loader.o

# Enhanced plugin source files (everything Enhanced)
ENHANCED_PLUGIN_OBJS = chatafl-enhanced-plugin.o \
                       plugin-manager.o \
                       plugin-interface.o \
                       plugin-verifier.o \
                       plugin-cegar.o \
                       plugin-scheduler.o \
                       verifier.o \
                       cegar-refinement.o \
                       cegar-optimized.o \
                       state-scheduler.o \
                       state-graph.o \
                       cfg-parser.o \
                       module-interface.o

.PHONY: all clean afl-fuzz-clean plugin

all: afl-fuzz chatafl-enhanced.so

#############################################
# AFL Fuzzer (Clean Version)                #
#############################################

afl-fuzz: $(AFL_CORE_OBJS)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS)
	@echo "[+] Built clean AFL with plugin loader: $@"

afl-fuzz.o: afl-fuzz.c afl-plugin-loader.h afl-plugin-api.h
	$(CC) $(CFLAGS) -c $< -o $@

afl-plugin-loader.o: afl-plugin-loader.c afl-plugin-loader.h afl-plugin-api.h
	$(CC) $(CFLAGS) -c $< -o $@

#############################################
# ChatAFL Enhanced Plugin (.so)             #
#############################################

chatafl-enhanced.so: $(ENHANCED_PLUGIN_OBJS)
	$(CC) $(PLUGIN_LDFLAGS) $^ -o $@ $(ENHANCED_LIBS)
	@echo "[+] Built Enhanced plugin: $@"

# Plugin entry point
chatafl-enhanced-plugin.o: chatafl-enhanced-plugin.c afl-plugin-api.h plugin-manager.h plugin-interface.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -c $< -o $@

# Plugin manager and interface
plugin-manager.o: plugin-manager.c plugin-manager.h plugin-interface.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -c $< -o $@

plugin-interface.o: plugin-interface.c plugin-interface.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -c $< -o $@

# Plugin adapters
plugin-verifier.o: plugin-verifier.c plugin-interface.h verifier.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -c $< -o $@

plugin-cegar.o: plugin-cegar.c plugin-interface.h cegar-refinement.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -c $< -o $@

plugin-scheduler.o: plugin-scheduler.c plugin-interface.h state-scheduler.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -c $< -o $@

# Legacy modules (need to be self-contained for .so)
verifier.o: verifier.c verifier.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -DAFL_PLUGIN_BUILD -c $< -o $@

cegar-refinement.o: cegar-refinement.c cegar-refinement.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -DAFL_PLUGIN_BUILD -c $< -o $@

cegar-optimized.o: cegar-optimized.c cegar-optimized.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -DAFL_PLUGIN_BUILD -c $< -o $@

state-scheduler.o: state-scheduler.c state-scheduler.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -DAFL_PLUGIN_BUILD -c $< -o $@

state-graph.o: state-graph.c state-graph.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -DAFL_PLUGIN_BUILD -c $< -o $@

cfg-parser.o: cfg-parser.c cfg-parser.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -DAFL_PLUGIN_BUILD -c $< -o $@

module-interface.o: module-interface.c module-interface.h
	$(CC) $(CFLAGS) $(PLUGIN_CFLAGS) -DAFL_PLUGIN_BUILD -c $< -o $@

#############################################
# Utilities                                 #
#############################################

clean:
	rm -f *.o afl-fuzz chatafl-enhanced.so
	@echo "[+] Cleaned build artifacts"

test: all
	@echo "[*] Testing plugin loading..."
	./afl-fuzz --load-plugin ./chatafl-enhanced.so -h || true
	@echo "[+] If no errors above, plugin system is working!"

.SILENT: clean test
