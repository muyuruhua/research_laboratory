FROM ubuntu:20.04

# StateAFL image for Kamailio (ProtoPair benchmark).
# Target is compiled with StateAFL's own afl-clang-fast (stateafl/README.md),
# without AFL_USE_ASAN, following the README build/demo convention.

# Install common dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -y update || (sleep 10 && apt-get -y update) || (sleep 15 && apt-get -y update) && \
    apt-get -y install sudo \
    apt-utils \
    build-essential \
    openssl \
    clang \
    graphviz-dev \
    git \
    autoconf \
    libgnutls28-dev \
    libssl-dev \
    llvm \
    python3-pip \
    nano \
    net-tools \
    vim \
    gdb \
    netcat \
    strace \
    libcap-dev \
    libpcre2-dev \
    libpcre2-8-0 \
    libcurl4-openssl-dev \
    libjson-c-dev \
    wget

# Add a new user ubuntu, pass: ubuntu
RUN groupadd ubuntu && \
    useradd -rm -d /home/ubuntu -s /bin/bash -g ubuntu -G sudo -u 1000 ubuntu -p "$(openssl passwd -1 ubuntu)"

RUN chmod 777 /tmp

RUN pip3 install gcovr==4.2

# Use ubuntu as default username
USER ubuntu
WORKDIR /home/ubuntu

# Import environment variable to pass as parameter to make (e.g., to make parallel builds with -j)
ARG MAKE_OPT

# Set up StateAFL (stateafl/README.md: core, then llvm_mode with LLVM_CONFIG)
COPY --chown=ubuntu:ubuntu stateafl stateafl
RUN cd stateafl && \
    make clean all $MAKE_OPT && \
    cd llvm_mode && LLVM_CONFIG=llvm-config make $MAKE_OPT

# Set up environment variables for StateAFL
ENV WORKDIR="/home/ubuntu/experiments"
ENV STATEAFL="/home/ubuntu/stateafl"
# Append STATEAFL to PATH (like the aflnet images). Do NOT prepend: the AFL
# build creates an "as -> afl-as" symlink inside $STATEAFL that would shadow
# the system assembler and break plain gcc (gcov builds, configure probes).
ENV PATH="${PATH}:${STATEAFL}:/home/ubuntu/.local/bin:${WORKDIR}"
ENV AFL_PATH="${STATEAFL}"
ENV AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1 \
    AFL_SKIP_CPUFREQ=1 \
    AFL_NO_AFFINITY=1

RUN mkdir $WORKDIR

USER root
RUN apt-get -y update || (sleep 10 && apt-get -y update) || (sleep 15 && apt-get -y update) && \
    apt-get -y install \
    bison \
    flex
USER ubuntu

COPY --chown=ubuntu:ubuntu kamailio.patch ${WORKDIR}/kamailio.patch
COPY --chown=ubuntu:ubuntu pjsip.patch ${WORKDIR}/pjsip.patch

# Set up Kamailio for StateAFL fuzzing (same commit + patch as the aflnet image)
RUN cd $WORKDIR && \
    git clone https://github.com/kamailio/kamailio.git && \
    cd kamailio && \
    git checkout a2209018fb03d && \
    patch -p1 < $WORKDIR/kamailio.patch && \
    CC=$STATEAFL/afl-clang-fast make MEMPKG=sys cfg && \
    CC=$STATEAFL/afl-clang-fast make all $MAKE_OPT

# Set up pjproject (used by the run_pjsip cleanup script)
RUN cd $WORKDIR && \
    git clone https://github.com/pjsip/pjproject.git && \
    cd pjproject && \
    git checkout 87cd4a && \
    patch -p1 < $WORKDIR/pjsip.patch && \
    ./configure && \
    make dep && make clean && make $MAKE_OPT

# Download and compile Kamailio for code coverage analysis
RUN cd $WORKDIR && \
    git clone https://github.com/kamailio/kamailio.git kamailio-gcov && \
    cd kamailio-gcov && \
    git checkout a2209018fb03d && \
    patch -p1 < $WORKDIR/kamailio.patch && \
    make CC_EXTRA_OPTS="-fprofile-arcs -ftest-coverage" LD_EXTRA_OPTS="-fprofile-arcs -ftest-coverage" MEMPKG=sys cfg && \
    make CC_EXTRA_OPTS="-fprofile-arcs -ftest-coverage" LD_EXTRA_OPTS="-fprofile-arcs -ftest-coverage" all $MAKE_OPT

COPY --chown=ubuntu:ubuntu in-sip ${WORKDIR}/in-sip
# StateAFL parses requests with the generic length-prefixed (replayable) format
COPY --chown=ubuntu:ubuntu in-sip-replay ${WORKDIR}/in-sip-replay
COPY --chown=ubuntu:ubuntu cov_script.sh ${WORKDIR}/cov_script
COPY --chown=ubuntu:ubuntu run.sh ${WORKDIR}/run
COPY --chown=ubuntu:ubuntu run_pjsip.sh ${WORKDIR}/run_pjsip
COPY --chown=ubuntu:ubuntu kamailio-basic.cfg ${WORKDIR}/kamailio-basic.cfg
COPY --chown=ubuntu:ubuntu StarWars3.wav ${WORKDIR}/StarWars3.wav
