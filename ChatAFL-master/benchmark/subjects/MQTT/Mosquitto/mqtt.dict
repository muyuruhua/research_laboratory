# MQTT Protocol Dictionary for Fuzzing

# MQTT Control Packet Types
"\x10"  # CONNECT
"\x20"  # CONNACK
"\x30"  # PUBLISH
"\x40"  # PUBACK
"\x50"  # PUBREC
"\x60"  # PUBREL
"\x70"  # PUBCOMP
"\x80"  # SUBSCRIBE
"\x90"  # SUBACK
"\xa0"  # UNSUBSCRIBE
"\xb0"  # UNSUBACK
"\xc0"  # PINGREQ
"\xd0"  # PINGRESP
"\xe0"  # DISCONNECT

# Protocol Name
"MQTT"
"MQIsdp"

# Protocol Levels
"\x03"  # MQTT 3.1
"\x04"  # MQTT 3.1.1
"\x05"  # MQTT 5.0

# Connect Flags
"\x02"  # Clean Session
"\x04"  # Will Flag
"\x06"  # Will QoS
"\x20"  # Will Retain
"\x40"  # Password Flag
"\x80"  # Username Flag

# QoS Levels
"\x00"  # QoS 0
"\x01"  # QoS 1
"\x02"  # QoS 2

# Common Topic Patterns
"test/topic"
"sensor/data"
"device/status"
"$SYS/#"
"/status"
"#"
"+"

# Property Identifiers (MQTT 5.0)
"\x01"  # Payload Format Indicator
"\x02"  # Message Expiry Interval
"\x03"  # Content Type
"\x08"  # Response Topic
"\x09"  # Correlation Data
"\x11"  # Session Expiry Interval
"\x21"  # Receive Maximum
"\x22"  # Topic Alias Maximum
"\x23"  # Topic Alias
"\x24"  # Maximum QoS
"\x25"  # Retain Available
"\x26"  # User Property
"\x27"  # Maximum Packet Size

# Return Codes
"\x00"  # Success
"\x01"  # Unacceptable Protocol Version
"\x02"  # Identifier Rejected
"\x03"  # Server Unavailable
"\x04"  # Bad Username or Password
"\x05"  # Not Authorized

# Client IDs
"client_001"
"mqtt_fuzzer"
"test_client"

# Common Payloads
"Hello MQTT"
"Test Message"
"{\"sensor\":\"temperature\",\"value\":25.5}"
"ON"
"OFF"
