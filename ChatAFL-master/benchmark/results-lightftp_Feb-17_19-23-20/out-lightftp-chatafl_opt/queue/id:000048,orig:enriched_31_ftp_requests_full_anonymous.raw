USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
APPE /path/to/file.txt
LIST
STOR /path/to/newfile.txt
REST 0
RETR /path/to/newfile.txt
LIST
APPE /path/to/invalid/../../etc/passwd
LIST
APPE /path/to/file_with_long_name_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt
APPE /path/to/file_with_special_chars_@
LIST
MKD /nested/dir/a/b/c/d/e
LIST
MKD /nested/dir/emptydir/
LIST /nested/dir/emptydir/
QUIT

