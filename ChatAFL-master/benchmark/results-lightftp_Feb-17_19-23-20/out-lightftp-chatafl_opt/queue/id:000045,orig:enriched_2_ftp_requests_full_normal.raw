USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
APPE validfile.txt
STOR testfile.txt
REST 0
RETR testfile.txt
MKD /../../etc
MKD test/long_directory_name_exceeding_the_normal_length_limit_of_two_hundred_and_fifty_six_characters
MKD test/@
MKD test/empty/
MKD test/nested/dir1
MKD test/nested/dir1/dir2
MKD test/nested/dir1/dir2/dir3
RMD test/nested/dir1/dir2
RMD test/nested/dir1/dir2/dir3
QUIT

