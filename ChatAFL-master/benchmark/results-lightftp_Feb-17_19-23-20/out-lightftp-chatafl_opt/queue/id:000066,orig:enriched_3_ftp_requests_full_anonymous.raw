USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
LIST
APPE /path/to/file.txt
NOOP
STOR /path/to/file.txt
REST 100
RETR /path/to/nonexistentfile.txt
MKD /newdir
MKD /newdir/@
MKD /newdir/../../etc
DELE /path/to/file.txt
RNTO /path/to/renamedfile.txt
RNFR /path/to/renamedfile.txt
LIST /path/to/emptydir/
LIST /path/to/dir_with_permission_denied/
LIST /path/to/longnamefile_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
QUIT

