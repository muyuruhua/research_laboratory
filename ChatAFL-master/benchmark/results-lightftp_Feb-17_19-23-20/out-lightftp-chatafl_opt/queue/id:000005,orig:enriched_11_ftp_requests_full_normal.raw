USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
RNFR test
RNTO new_test
CWD /invalid/path/../../etc
CWD /valid/path
CWD /valid/path/with/long/name/that/exceeds/the/typical/limit/and/should/be/greater/than/256/characters/abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz
MKD @
MKD
MKD nested/dir1
MKD nested/dir1/dir2
MKD nested/dir1/dir2/dir3
REST 0
RETR missingfile.txt
QUIT

