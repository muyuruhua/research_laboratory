USER ubuntu
PASS ubuntu
SYST
PWD
CWD /valid/path
CWD /../../etc
PORT 127,0,0,1,132,209
LIST
MKD test
CWD test
MKD a
MKD a/b
MKD a/b/c
MKD a/b/c/d
MKD a/b/c/d/e
STOR file.txt
REST 0
RETR file.txt
CWD /invalid/path
CWD /valid/path/../../etc
MKD test_with_long_name_12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
MKD test_with_special_chars_@
QUIT

