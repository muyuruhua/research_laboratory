USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
STAT
FEAT
MKD test
STOR testfile
REST 0
RETR testfile
MKD /../../etc
MKD invalid_dir
MKD test/long_directory_name_exceeding_the_limit_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz
MKD test/special_chars_@
MKD test/empty_dir/
MKD test/renamed_dir
RNFR test/renamed_dir
RNTO test/new_dir
MKD a
MKD a/b
MKD a/b/c
MKD a/b/c/d
MKD a/b/c/d/e
QUIT

