USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
STAT /invalid/path
RNTO /../../etc
STOR valid_file.txt
REST 0
MKD a/b/c/d/e
RNTO long_directory_name_that_exceeds_the_normal_length_limit_of_filenames_and_paths_in_the_ftp_server_which_should_test_the_boundaries_of_the_system
MKD @
MKD ""
STAT /test
LIST /nonexistent_directory
RNTO /test/invalid_rename
QUIT

