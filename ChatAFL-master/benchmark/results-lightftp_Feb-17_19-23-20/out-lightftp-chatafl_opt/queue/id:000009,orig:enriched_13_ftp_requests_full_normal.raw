USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
RNFR /invalid/path
RNTO /new/path
LIST
MKD test
MKD /../../etc
MKD /test/long_directory_name_exceeding_the_normal_limit_of_two_hundred_and_fifty_six_characters_to_test_the_boundaries_of_the_system
MKD @
REST 100
RETR /missing/file
QUIT

