USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
CWD /valid/path
MKD /newdir
CWD /../../etc
MKD /invalid/path/with/too/many/../segments
CWD /valid/path
MKD /a/b/c/d/e
CWD /valid/path
MKD /longname/`echo $(head -c 260 /dev/zero | tr '0' 'a')`
CWD /valid/path
LIST
CWD /nonexistent
MKD /special@
CWD /valid/path
CWD /valid/path
CWD /valid/path
REST 0
RETR file.txt
QUIT

