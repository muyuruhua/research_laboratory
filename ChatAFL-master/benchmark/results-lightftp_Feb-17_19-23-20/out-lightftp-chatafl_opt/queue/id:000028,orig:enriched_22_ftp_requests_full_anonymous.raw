USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
LIST
DELE /nonexistentfile.txt
DELE /../../etc/passwd
DELE /validfile.txt
STOR /path/to/uploadfile.txt
REST 100
RETR /path/to/file.txt
MKD /nested/dir1
MKD /nested/dir1/nested/dir2
LIST /path/to/longfilename12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234.txt
LIST /path/to/special@
LIST
QUIT

