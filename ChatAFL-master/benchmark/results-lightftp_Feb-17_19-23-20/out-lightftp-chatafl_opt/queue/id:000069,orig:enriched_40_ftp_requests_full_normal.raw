USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
PASV
LIST
MKD test
STOR testfile
REST 0
RETR testfile
MKD /../../etc
MKD test/long_directory_name_exceeding_the_normal_length_limit_256_characters_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz
MKD test/@
MKD test/dir1
MKD test/dir1/dir2
MKD test/dir1/dir2/dir3
MKD test/dir1/dir2/dir3/dir4
MKD test/dir1/dir2/dir3/dir4/dir5
RNTO testfile_renamed
RNTO testfile_renamed_again
LIST
QUIT

