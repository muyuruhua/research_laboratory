USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
STAT
LIST
MKD test
STOR testfile.txt
RETR non_existing_file.txt
MKD a
MKD a/b
MKD a/b/c
MKD a/b/c/d
MKD a/b/c/d/e
RETR /../../etc/passwd
RETR testfile.txt
RETR /invalid/path/file.txt
MKD @
MKD long_directory_name_12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
LIST
QUIT

