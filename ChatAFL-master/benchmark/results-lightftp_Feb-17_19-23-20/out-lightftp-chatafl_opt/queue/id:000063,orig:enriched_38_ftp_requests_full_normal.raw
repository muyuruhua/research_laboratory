USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
STOR testfile
RETR testfile
REST 100
RETR non_existent_file
MKD /../../etc
RETR testfile
RNTO new_testfile
RNTO /../../etc/passwd
MKD a
MKD a/b
MKD a/b/c
MKD a/b/c/d
MKD a/b/c/d/e
RNTO a/b/c/d/e/long_directory_name_exceeding_the_normal_length_limit_of_filenames_256_chars_test_case
RETR
RETR @
QUIT

