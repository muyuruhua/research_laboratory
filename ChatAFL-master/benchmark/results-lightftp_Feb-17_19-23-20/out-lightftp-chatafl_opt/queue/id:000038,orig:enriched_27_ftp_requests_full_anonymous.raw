PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
RNFR /valid/path/oldname.txt
RNTO /valid/path/newname.txt
LIST
RNFR /invalid/path/../../etc/passwd
RNTO /invalid/path/newname.txt
