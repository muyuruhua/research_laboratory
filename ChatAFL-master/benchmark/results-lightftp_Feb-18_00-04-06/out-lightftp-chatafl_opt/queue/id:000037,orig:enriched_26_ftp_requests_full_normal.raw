USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
CWD /valid/path
CWD /../../etc
CWD /nonexistent/path
CWD /valid/path/with/special/@
CWD
LIST
MKD test
MKD a/b/c/d/e
MKD long_directory_name_exceeding_the_normal_limit_of_256_characters_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmno
RMD test
RMD /invalid/path
RMD /nonexistent_directory
RMD /valid/path/test
STOR file.txt
REST 0
RETR file.txt
QUIT

