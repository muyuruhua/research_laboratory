USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
RMD test
STOR testfile.txt
REST 0
RETR testfile.txt
MKD long_directory_name_exceeding_the_normal_length_limit_of_two_hundred_and_fifty_six_characters_to_test_the_boundaries_of_the_ftp_server
MKD test/@
RMD /../../etc
RMD nonexistent_directory
RMD test/empty_dir/
RMD test/long_directory_name_exceeding_the_normal_length_limit_of_two_hundred_and_fifty_six_characters_to_test_the_boundaries_of_the_ftp_server
RMD test/RENAME_ME
RMD test/RENAME_ME
RMD test/RENAME_ME
QUIT

