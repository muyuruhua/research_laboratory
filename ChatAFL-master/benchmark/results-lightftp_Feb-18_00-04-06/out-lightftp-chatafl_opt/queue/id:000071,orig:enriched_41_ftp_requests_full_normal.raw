USER ubuntu
PASS ubuntu
SYST
PWD
CWD /invalid/path/../../etc
PORT 127,0,0,1,132,209
LIST
MKD test
CWD test
MKD nested1
CWD nested1
MKD nested2
CWD ../..
CWD test/nested1/nested2
CWD /test/nested1/nested2
TYPE I
TYPE A
TYPE B
REST 100
RETR testfile.txt
STOR testfile.txt
CWD /test/nested1
CWD /test/nested1/invalid
LIST
MKD long_directory_name_exceeding_the_standard_length_limit_of_256_characters_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz
MKD special@
CWD /test/nested1/special@
QUIT

