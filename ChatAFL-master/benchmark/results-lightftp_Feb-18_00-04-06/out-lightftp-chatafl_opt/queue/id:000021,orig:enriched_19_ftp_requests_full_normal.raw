USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
RNFR /path/to/oldname
RNTO /path/to/newname
LIST
MKD test
STOR file.txt
REST 0
RETR file.txt
MKD /../../etc
MKD test/invalid/../../path
MKD long_directory_name_1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
MKD test/special_chars_@
MKD a/b/c/d/e
RNFR /path/to/oldname
RNTO /path/to/newname
QUIT

