USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
CWD test
STOR valid_file.txt
STOR invalid_file.txt
CWD /../../etc
STOR long_filename_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt
STOR special_chars_@
MKD nested_dir
CWD nested_dir
MKD a
CWD a
MKD b
CWD b
MKD c
CWD c
MKD d
CWD d
MKD e
CWD e
REST 100
RETR valid_file.txt
RETR missing_file.txt
QUIT

