USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
APPE /path/to/file.txt
RNFR /path/to/file.txt
RNTO /path/to/renamed_file.txt
STOR /path/to/store_file.txt
REST 100
RETR /path/to/retr_file.txt
LIST
MKD /new_dir
MKD /new_dir/nested_dir
RNFR /new_dir/nested_dir
RNTO /new_dir/renamed_nested_dir
LIST /invalid/path/../../etc
STOR /path/to/long_filename_.txt
STOR /path/to/special_char_file_@
QUIT

