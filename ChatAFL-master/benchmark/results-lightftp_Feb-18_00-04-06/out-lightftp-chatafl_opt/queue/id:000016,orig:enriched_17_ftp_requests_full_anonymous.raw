USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
LIST
APPE /path/to/file.txt
STOR /path/to/file.txt
REST 100
RETR /path/to/file.txt
HELP
MKD /newdir
MKD /newdir/nesteddir
DELE /nonexistentfile.txt
LIST /../../etc
LIST /path/to/invalid/file
LIST /path/to/permission/denied
APPE /path/to/longnamefile_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt
APPE /path/to/specialchars/@
APPE /path/to/emptyargs/
APPE /path/to/dir/with/very/long/path/name/that/exceeds/the/normal/length/limits
QUIT

