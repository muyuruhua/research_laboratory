USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
RNFR /path/to/oldfile
RNTO /path/to/newfile
STOR /path/to/file
REST 0
RETR /path/to/file
HELP
LIST
PWD
LIST /invalid/path
RNFR /../../etc/passwd
RNTO /path/to/newfile
MKD /new/dir
MKD /new/dir/@
MKD /new/dir/longname/`echo $(for i in {1..260}
QUIT

