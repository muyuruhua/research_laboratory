USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
STAT /invalid/path
MKD test
RMD test
STOR file.txt
REST 0
RETR file.txt
MKD a/b/c/d/e
MKD long_directory_name_exceeding_the_normal_limit_of_256_characters_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz
MKD test@
MKD empty_dir/
RMD /../../etc
RMD /invalid/dir
QUIT

