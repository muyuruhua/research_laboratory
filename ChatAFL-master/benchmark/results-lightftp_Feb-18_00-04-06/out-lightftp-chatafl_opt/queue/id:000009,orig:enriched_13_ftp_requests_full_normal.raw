USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
CWD /test
MKD nested_dir
CWD nested_dir
MKD a
MKD b
CWD a
MKD c
CWD b
MKD d
CWD ../../..
CWD /nonexistent_dir
CWD /../../etc
CWD /test/invalid_path/
PORT 127,0,0,1,132,210
STOR file.txt
REST 0
RETR file.txt
MKD test_with_long_name_12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
MKD test_with_special_chars_@
MKD test_with_empty_name_
CWD a/b/c/d/e
CWD a/b/c/d/e/invalid_path
CWD a/b/c/d/e/../../..
CWD a/b/c/d/e/./
QUIT

