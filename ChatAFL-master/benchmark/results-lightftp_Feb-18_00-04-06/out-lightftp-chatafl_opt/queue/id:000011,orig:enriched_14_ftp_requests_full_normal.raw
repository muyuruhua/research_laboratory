USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
ABOR
STAT
MKD /../../etc
MKD test/invalid_path
STOR valid_file.txt
REST 0
RETR missing_file.txt
MKD a/b/c/d/e
RNFR test
RNTO test_renamed
MKD long_directory_name_exceeding_the_normal_length_limit_123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
MKD special_chars_@
MKD
QUIT

