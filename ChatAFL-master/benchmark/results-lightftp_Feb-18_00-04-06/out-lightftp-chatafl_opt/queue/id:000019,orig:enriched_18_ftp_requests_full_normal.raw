USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
HELP
LIST
MKD test
MKD /../../etc
MKD test/long_directory_name_exceeding_the_usual_limit_of_256_characters_abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz
MKD test/special_chars_@
STOR file.txt
REST 0
RETR non_existent_file.txt
LIST
MKD test/nested/dir1/dir2/dir3/dir4/dir5
RNFR test
RNTO test_renamed
QUIT

