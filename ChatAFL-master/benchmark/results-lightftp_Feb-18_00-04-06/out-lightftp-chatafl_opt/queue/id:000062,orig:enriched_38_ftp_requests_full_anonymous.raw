USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
LIST
STOR /valid/path/file.txt
REST 0
RETR /valid/path/file.txt
MKD /newdir
MKD /newdir/nesteddir
LIST /newdir/nesteddir
STOR /newdir/nesteddir/longfilename_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt
STOR /newdir/nesteddir/special@
STOR /newdir/nesteddir/emptyfile.txt
DELE /newdir/nesteddir/nonexistentfile.txt
DELE /newdir/nesteddir/permission_denied_file.txt
RETR /newdir/nesteddir/permission_denied_file.txt
QUIT

