USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
LIST
MKD test
STOR valid_file.txt
STOR /../../etc/passwd
STOR other_file.txt
REST 0
RETR missing_file.txt
RMD test
RMD /../../etc
MKD a
MKD a/b
MKD a/b/c
MKD a/b/c/d
MKD a/b/c/d/e
STOR long_filename_12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890.txt
STOR special@
STOR
QUIT

