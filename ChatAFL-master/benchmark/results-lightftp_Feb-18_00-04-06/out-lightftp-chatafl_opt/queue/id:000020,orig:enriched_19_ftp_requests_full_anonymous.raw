USER anonymous
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,152,193
LIST
APPE validfile.txt
STOR validfile.txt
REST 0
RETR validfile.txt
MKD /newdir
DELE /newdir/nonexistentfile.txt
CWD /newdir
CWD /newdir/../../etc
RMD /newdir
RNFR validfile.txt
RNTO renamedfile.txt
RNTO /newdir/renamedfile.txt
QUIT

