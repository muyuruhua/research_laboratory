USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
RNFR test
RNTO test_renamed
CWD /invalid/path/../../etc
CWD /test
LIST
MKD test
MKD a/b/c/d/e
MKD long_directory_name_exceeding_the_normal_length_limit_256_characters_long_1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
MKD special@
CWD /test/nonexistent
CWD /test/permission_denied
REST 100
RETR nonexistent_file
STOR valid_file
QUIT

