USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
STAT
TYPE I
LIST
STOR testfile
REST 0
RETR testfile
MKD test
MKD /../../etc
MKD longdirname_12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890
MKD test@dir
MKD test
MKD test$dir
RETR non_existing_file
MKD a/b/c/d/e
RNTO a/b/c/d/e/renamed_dir
QUIT

