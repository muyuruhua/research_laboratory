USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
CWD /valid/path
CWD /../../etc
CWD /long/path/with/special/chars/@
CWD /very/long/path/that/exceeds/the/typical/limit/for/a/directory/name/that/has/more/than/256/characters/and/should/cause/an/error
STAT /valid/path
STAT /invalid/path
LIST
MKD test
MKD /valid/path/test
MKD /invalid/path/../../etc
MKD /long/dir/name/with/special/chars/@
MKD /valid/path/nested/dir/a/b/c/d/e
STOR testfile
REST 0
RETR testfile
QUIT

