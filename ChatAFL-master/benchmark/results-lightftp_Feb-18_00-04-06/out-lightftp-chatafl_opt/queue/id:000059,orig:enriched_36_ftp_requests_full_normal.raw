USER ubuntu
PASS ubuntu
SYST
PWD
PORT 127,0,0,1,132,209
RNFR test
RNTO test_renamed
STAT /invalid/path
LIST
MKD test
MKD a/b/c/d/e
MKD test_special_
MKD long_directory_name_exceeding_the_normal_limit_of_two_hundred_and_fifty_six_characters_to_test_the_boundary_conditions_and_see_how_the_server_handles_such_cases
STOR file.txt
REST 100
RETR file.txt
STAT /etc/passwd
PORT 127,0,0,1,132,210
QUIT

