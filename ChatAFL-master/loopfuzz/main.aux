\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces LoopFuzz changes the LLM from a queue producer into a bounded policy proposer. The Grammar Hypothesis Loop maintains message hypotheses, the Fuzz Execution Loop updates coverage and IPSM feedback, and the LLM Intervention Loop proposes bounded interventions; runtime admission checks mediate each proposal before it can affect the queue.}}{6}\protected@file@percent }
\newlabel{fig:arch}{{2}{6}}
