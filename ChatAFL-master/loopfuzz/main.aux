\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Primary end-of-campaign results for \texttt  {b\_abs} and \texttt  {edges} (mean $\pm $ sample SD over selected completed runs). Bold marks the highest mean among AFLNet, ChatAFL, and LoopFuzz. $^*$ marks LoopFuzz \texttt  {b\_abs} wins significant versus both primary baselines under a two-sided exact Mann-Whitney U test at $p < 0.05$; $^\dagger $ marks LoopFuzz \texttt  {edges} wins significant versus both primary baselines. All rows use 10 runs per fuzzer except LightFTP ChatAFL, where the updated archive contains six eligible completed runs.}}{15}\protected@file@percent }
\newlabel{tab:24h_results}{{2}{15}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Auxiliary four-way NSFuzz comparison using \texttt  {b\_abs} and \texttt  {edges}. Bold marks the highest mean within each row and metric. NSFuzz \texttt  {edges} is reported as an archived artifact field, not as a guaranteed semantically identical IPSM abstraction. All rows use the selected-run rule; LightFTP ChatAFL has six eligible runs, and the other cells have 10 selected runs.}}{15}\protected@file@percent }
\newlabel{tab:aux_results}{{3}{15}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces MQTT auxiliary comparison. AFLNet and LoopFuzz are taken from the provided Mosquitto run summaries; MBFuzzer is taken from its Mosquitto summary. This is not a same-budget or same-metric comparison: LoopFuzz runs are much shorter, and MBFuzzer reports \texttt  {branch\_covered} under its own artifact format rather than \texttt  {b\_abs} and \texttt  {edges}.}}{15}\protected@file@percent }
