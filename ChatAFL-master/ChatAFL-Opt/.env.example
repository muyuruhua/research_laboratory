# ChatAFL-Opt Docker 环境配置

# OpenAI API 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# AFL 配置
AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1
AFL_SKIP_CPUFREQ=1
AFL_NO_AFFINITY=1
AFL_TMPDIR=/tmp

# ChatAFL-Opt 特定配置
# LLM 温度设置
HYPOTHESIS_TEMPERATURE=0.3
CEGAR_TEMPERATURE=0.1

# 验证器配置
VERIFICATION_TIMEOUT=5000
MAX_REFINEMENT_ITERATIONS=10

# 调度器配置
PLATEAU_THRESHOLD=1000
COVERAGE_WEIGHT=0.6
RECENCY_WEIGHT=0.4

# 容器资源限制
CONTAINER_CPUS=4.0
CONTAINER_MEMORY=8G

# 网络配置
TARGET_HOST=127.0.0.1
TARGET_PORT=21
PROTOCOL=FTP

# 目录配置
SEEDS_DIR=./seeds
RESULTS_DIR=./results
TARGETS_DIR=./targets

# 日志配置
LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
