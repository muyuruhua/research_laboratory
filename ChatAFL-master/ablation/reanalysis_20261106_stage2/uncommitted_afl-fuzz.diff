+static u8 prov_slot_set_subset(const u8 *subset, const u8 *set) {
+  if (!subset || !set) return 0;
+  for (u32 i = 0; i < HNB_SLOT_SET_BYTES; i++)
+    if (subset[i] & (u8)~set[i]) return 0;
+  return 1;
