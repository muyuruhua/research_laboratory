+
+static u32 prov_slot_set_count(const u8 *slots) {
+  u32 count = 0;
+  if (!slots) return 0;
+  for (u32 i = 0; i < HNB_SLOT_SET_BYTES; i++) {
+    u8 value = slots[i];
+    while (value) {
+      count += value & 1u;
+      value >>= 1;
+    }
+  }
+  return count;
+}
+
+static void prov_slot_set_overlap_counts(const u8 *a, const u8 *b,
+                                         u32 *overlap, u32 *outside_b) {
+  u32 in_count = 0, out_count = 0;
+  if (a && b) {
+    for (u32 i = 0; i < HNB_SLOT_SET_BYTES; i++) {
+      u8 in = a[i] & b[i];
+      u8 out = a[i] & (u8)~b[i];
+      while (in) { in_count += in & 1u; in >>= 1; }
+      while (out) { out_count += out & 1u; out >>= 1; }
+    }
+  }
+  if (overlap) *overlap = in_count;
+  if (outside_b) *outside_b = out_count;
+}
