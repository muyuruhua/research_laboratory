+
+static u8 prov_slot_set_nonempty(const u8 *slots) {
+  if (!slots) return 0;
+  for (u32 i = 0; i < HNB_SLOT_SET_BYTES; i++)
+    if (slots[i]) return 1;
+  return 0;
