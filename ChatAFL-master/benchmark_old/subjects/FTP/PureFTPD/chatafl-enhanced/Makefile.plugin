#
# ChatAFL-Enhanced Makefile - PLUGIN ARCHITECTURE
#
# This Makefile supports the new plugin-based architecture.
# Plugins can be enabled/disabled at compile time or runtime.
#

PROGNAME    = afl
VERSION     = 2.52b-plugin

PREFIX     ?= /usr/local
BIN_PATH    = $(PREFIX)/bin
HELPER_PATH = $(PREFIX)/lib/afl
DOC_PATH    = $(PREFIX)/share/doc/afl
MISC_PATH   = $(PREFIX)/share/afl

PROGS       = afl-gcc afl-fuzz afl-replay aflnet-replay aflnet-client afl-showmap afl-tmin afl-gotcpu afl-analyze
SH_PROGS    = afl-plot afl-cmin afl-whatsup

# Match ChatAFL optimization level
CFLAGS     ?= -O3 -funroll-loops
CFLAGS     += -Wall -D_FORTIFY_SOURCE=2 -g -Wno-pointer-sign -Wno-unused-result \
              -DAFL_PATH=\"$(HELPER_PATH)\" -DDOC_PATH=\"$(DOC_PATH)\" \
              -DBIN_PATH=\"$(BIN_PATH)\"

# ============================================================================
# PLUGIN SYSTEM CONFIGURATION
# ============================================================================

# Enable Enhanced features (set CHATAFL_ENHANCED=1 to enable)
ifdef CHATAFL_ENHANCED
  CFLAGS += -DCHATAFL_ENHANCED=1
  
  # Platform-specific library paths
  ifeq "$(shell uname)" "Darwin"
    # macOS with Homebrew
    CFLAGS += -I/opt/homebrew/opt/json-c/include -I/opt/homebrew/opt/pcre2/include
    CFLAGS += -I/opt/homebrew/opt/graphviz/include
    LDFLAGS += -L/opt/homebrew/opt/json-c/lib -L/opt/homebrew/opt/pcre2/lib
    LDFLAGS += -L/opt/homebrew/opt/graphviz/lib -lgvc -lcgraph
  endif
  
  # Core plugin system (always included when CHATAFL_ENHANCED=1)
  PLUGIN_CORE_OBJS = plugin-manager.o afl-plugin-loader.o
  
  # Legacy module objects (wrapped as plugins)
  LEGACY_MODULE_OBJS = verifier.o cegar-refinement.o state-scheduler.o \
                       cegar-optimized.o state-graph.o cfg-parser.o module-interface.o
  
  # Plugin adapter objects (wrap legacy modules)
  PLUGIN_ADAPTER_OBJS = plugin-verifier.o plugin-cegar.o plugin-scheduler.o
  
  # All plugin objects
  PLUGIN_OBJS = $(PLUGIN_CORE_OBJS) $(PLUGIN_ADAPTER_OBJS) $(LEGACY_MODULE_OBJS)
else
  PLUGIN_OBJS =
endif

# ============================================================================
# PLATFORM DETECTION
# ============================================================================

ifneq "$(filter Linux GNU%,$(shell uname))" ""
  LDFLAGS  += -ldl -lgvc -lcgraph -lm -lcap
endif

ifeq "$(findstring clang, $(shell $(CC) --version 2>/dev/null))" ""
  TEST_CC   = afl-gcc
else
  TEST_CC   = afl-clang
endif

COMM_HDR    = alloc-inl.h config.h debug.h types.h

# ============================================================================
# BUILD TARGETS
# ============================================================================

all: test_x86 $(PROGS) afl-as test_build all_done

ifndef AFL_NO_X86
test_x86:
	@echo "[*] Checking for the ability to compile x86 code..."
	@echo 'main() { __asm__("xorb %al, %al"); }' | $(CC) -w -x c - -o .test || \
		( echo; echo "Oops, looks like your compiler can't generate x86 code."; \
		  echo; echo "Don't panic! You can use the LLVM or QEMU mode, but see docs/INSTALL first."; \
		  echo "(To ignore this error, set AFL_NO_X86=1 and try again.)"; echo; exit 1 )
	@rm -f .test
	@echo "[+] Plugin-based architecture ready!"
else
test_x86:
	@echo "[!] Note: skipping x86 compilation checks (AFL_NO_X86 set)."
endif

afl-gcc: afl-gcc.c $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c -o $@ $(LDFLAGS)
	ln -sf afl-gcc afl-g++

# ============================================================================
# AFL-FUZZ WITH PLUGIN SUPPORT
# ============================================================================

# Link with plugin system if CHATAFL_ENHANCED=1
afl-fuzz: afl-fuzz.c aflnet.o chat-llm.o $(PLUGIN_OBJS) $(COMM_HDR) | test_x86
	@echo "[*] Building afl-fuzz with plugin architecture..."
ifdef CHATAFL_ENHANCED
	@echo "    Plugins: ENABLED"
	@echo "    Plugin objects: $(PLUGIN_OBJS)"
else
	@echo "    Plugins: DISABLED (base ChatAFL)"
endif
	$(CC) $(CFLAGS) $@.c aflnet.o chat-llm.o $(PLUGIN_OBJS) -o $@ $(LDFLAGS) -lcurl -ljson-c -lpcre2-8

# ============================================================================
# OTHER BINARIES
# ============================================================================

afl-showmap: afl-showmap.c $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c aflnet.o -o $@ $(LDFLAGS)

afl-tmin: afl-tmin.c $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c aflnet.o -o $@ $(LDFLAGS)

afl-replay: afl-replay.c $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c aflnet.o -o $@ $(LDFLAGS)

aflnet-replay: aflnet-replay.c $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c aflnet.o -o $@ $(LDFLAGS)

aflnet-client: aflnet-client.c aflnet.o $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c aflnet.o -o $@ $(LDFLAGS)

afl-gotcpu: afl-gotcpu.c $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c -o $@ $(LDFLAGS)

afl-analyze: afl-analyze.c $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c -o $@ $(LDFLAGS)

afl-as: afl-as.c afl-as.h $(COMM_HDR) | test_x86
	$(CC) $(CFLAGS) $@.c -o $@ $(LDFLAGS)
	ln -sf afl-as as

# ============================================================================
# OBJECT FILE COMPILATION
# ============================================================================

aflnet.o: aflnet.c aflnet.h
	$(CC) $(CFLAGS) -c aflnet.c -o aflnet.o

chat-llm.o: chat-llm.c chat-llm.h
	$(CC) $(CFLAGS) -c chat-llm.c -o chat-llm.o

# Plugin Core
plugin-manager.o: plugin-manager.c plugin-interface.h
	$(CC) $(CFLAGS) -c plugin-manager.c -o plugin-manager.o

afl-plugin-loader.o: afl-plugin-loader.c afl-plugin-loader.h plugin-interface.h
	$(CC) $(CFLAGS) -c afl-plugin-loader.c -o afl-plugin-loader.o

# Plugin Adapters
plugin-verifier.o: plugin-verifier.c plugin-interface.h verifier.h
	$(CC) $(CFLAGS) -c plugin-verifier.c -o plugin-verifier.o

plugin-cegar.o: plugin-cegar.c plugin-interface.h cegar-refinement.h
	$(CC) $(CFLAGS) -c plugin-cegar.c -o plugin-cegar.o

plugin-scheduler.o: plugin-scheduler.c plugin-interface.h state-scheduler.h
	$(CC) $(CFLAGS) -c plugin-scheduler.c -o plugin-scheduler.o

# Legacy Modules (wrapped as plugins)
verifier.o: verifier.c verifier.h
	$(CC) $(CFLAGS) -c verifier.c -o verifier.o

cegar-refinement.o: cegar-refinement.c cegar-refinement.h
	$(CC) $(CFLAGS) -c cegar-refinement.c -o cegar-refinement.o

cegar-optimized.o: cegar-optimized.c cegar-optimized.h
	$(CC) $(CFLAGS) -c cegar-optimized.c -o cegar-optimized.o

state-scheduler.o: state-scheduler.c state-scheduler.h
	$(CC) $(CFLAGS) -c state-scheduler.c -o state-scheduler.o

state-graph.o: state-graph.c state-graph.h
	$(CC) $(CFLAGS) -c state-graph.c -o state-graph.o

cfg-parser.o: cfg-parser.c cfg-parser.h
	$(CC) $(CFLAGS) -c cfg-parser.c -o cfg-parser.o

module-interface.o: module-interface.c module-interface.h
	$(CC) $(CFLAGS) -c module-interface.c -o module-interface.o

# ============================================================================
# BUILD VERIFICATION
# ============================================================================

ifndef AFL_NO_X86
test_build: afl-gcc afl-as afl-showmap
	@echo "[*] Testing the CC wrapper and instrumentation output..."
	unset AFL_USE_ASAN AFL_USE_MSAN; AFL_QUIET=1 AFL_INST_RATIO=100 AFL_PATH=. \
		./$(TEST_CC) $(CFLAGS) test-instr.c -o test-instr $(LDFLAGS)
	echo 0 | ./afl-showmap -m none -q -o .test-instr0 ./test-instr
	echo 1 | ./afl-showmap -m none -q -o .test-instr1 ./test-instr
	@rm -f test-instr
	@cmp -s .test-instr0 .test-instr1; DR="$$?"; rm -f .test-instr0 .test-instr1; \
		if [ "$$DR" = "0" ]; then echo; echo "Oops, the instrumentation does not seem to be behaving correctly!"; \
		echo; echo "Please ping <lcamtuf@google.com> to troubleshoot the issue."; echo; exit 1; fi
	@echo "[+] All right, the instrumentation seems to be working!"
else
test_build:
	@echo "[!] Note: skipping build tests (you may need to use LLVM mode)."
endif

all_done: test_build
	@echo "[+] All done! Plugin-based ChatAFL-Enhanced is ready."
ifdef CHATAFL_ENHANCED
	@echo "    To disable plugins, rebuild with: make clean && make"
	@echo "    To enable plugins at runtime: export PLUGIN_ENABLE_ALL=1"
endif

# ============================================================================
# CLEANUP
# ============================================================================

clean:
	rm -f $(PROGS) afl-as as afl-g++ afl-clang afl-clang++ *.o *~ a.out core core.[1-9][0-9]* \
		*.stackdump test .test test-instr .test-instr0 .test-instr1 qemu_mode/qemu-2.10.0.tar.bz2 \
		afl-qemu-trace
	rm -rf out_dir qemu_mode/qemu-2.10.0
	$(MAKE) -C llvm_mode clean
	$(MAKE) -C libdislocator clean
	$(MAKE) -C libtokencap clean

install: all
	@echo "[*] Installing ChatAFL-Enhanced (plugin architecture)..."
	mkdir -p $$(dirname $(BIN_PATH)) $(HELPER_PATH) $(DOC_PATH) $(MISC_PATH)
	install -m 755 $(PROGS) $(SH_PROGS) $(BIN_PATH)
	install -m 755 afl-as $(HELPER_PATH)
	ln -sf afl-as $(HELPER_PATH)/as
	install -m 644 docs/*.txt $(DOC_PATH)
	@echo "[+] Installation complete!"
ifdef CHATAFL_ENHANCED
	@echo "    Plugin system is ACTIVE"
endif

.NOTPARALLEL: clean
